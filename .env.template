# ─────────────────────────────────────────────────────────────────────────────
# Materia — root deployment env for docker-compose.yml
#
# HOW TO USE:  cp .env.template .env   (then fill the TODOs below)
# NEVER commit the real .env — it holds secrets. Only this template is safe.
# docker-compose reads THIS file automatically (${VAR} interpolation).
# ─────────────────────────────────────────────────────────────────────────────

# ── Required secrets (compose refuses to boot without these) ──────────────────
# Generate real values into your local .env (NEVER commit them):
#   JWT_SECRET_KEY:       python -c "import secrets;print(secrets.token_urlsafe(64))"
#   FIELD_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#   POSTGRES_PASSWORD:    python -c "import secrets;print(secrets.token_urlsafe(24))"
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
FIELD_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── POTCAR (licensed VASP PAW tree, mounted read-only) ───────────────────────
# TODO: point this at your local licensed POTCAR directory. Required to boot.
POTCAR_DIR=/path/to/your/licensed/POTCARs

# ── Signup gating — PRIVATE LAUNCH (current phase) ────────────────────────────
# Keep invite-only until the paper is published. INVITE_CODES MUST be non-empty
# while SIGNUP_MODE=invite, or the app refuses to start.
SIGNUP_MODE=invite
INVITE_CODES=lab2026        # TODO: change to your own code(s), comma-separated

# ── Google sign-in — ENABLE AFTER PAPER PUBLISH ──────────────────────────────
# Leave BLANK for now. The "Continue with Google" button stays hidden while empty.
# AFTER the paper: (1) flip SIGNUP_MODE=open above so new Google users can register,
#                  (2) set GOOGLE_CLIENT_ID below,
#                  (3) add your https domain to the OAuth client's
#                      "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

# ── Public URL / HTTPS ───────────────────────────────────────────────────────
# SITE_ADDRESS: your domain for auto-HTTPS (e.g. materia.example.com); use :80 locally.
# SITE_URL:     full https URL — becomes the CORS ALLOWED_ORIGINS.
SITE_ADDRESS=:80
SITE_URL=http://localhost

# ── Optional tuning (safe defaults if omitted) ───────────────────────────────
MODEL_PROVIDER=gemini       # BYOK primary provider (users add their own key)
PMG_VASP_FUNCTIONAL=PBE_54
