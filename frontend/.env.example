# Frontend build-time settings (Vite). Copy to .env to override.
#
# Leave EMPTY for the web deployment: the app calls relative "/api" and Caddy proxies
# it to the backend on the same origin.
#
# Set an absolute URL only for the future desktop app, where the frontend and backend
# live on different origins, e.g. VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=
