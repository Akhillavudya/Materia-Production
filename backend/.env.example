# ── Materia backend environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Environment ──────────────────────────────────────────────────────────────
# "development" (default) keeps local dev frictionless. Set to "production" on the
# server: the app then REFUSES to start unless JWT_SECRET_KEY is strong (>=32 chars,
# not a placeholder) and FIELD_ENCRYPTION_KEY is a valid Fernet key.
ENV=development

# ── Auth / security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in production. Must be >= 32 chars and not a known placeholder.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet key used to encrypt user-supplied API keys at rest.
# Required in production (otherwise keys would be stored UNENCRYPTED).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Production: set DATABASE_URL to a PostgreSQL DSN and run `alembic upgrade head`.
# When DATABASE_URL is unset, the app falls back to the SQLite file at DB_PATH.
# DATABASE_URL=postgresql://materia:materia@localhost:5432/materia
DB_PATH=materia.db

# ── Async job system (optimize / MD run on a separate worker) ─────────────────
REDIS_URL=redis://localhost:6379/0
JOB_BACKEND=celery            # celery (default) | inline (dev, no broker)
MAX_JOB_WALLCLOCK_S=86400

# ── LLM provider ─────────────────────────────────────────────────────────────
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# ── Optional hosted-model / materials-database keys ──────────────────────────
# These can also be supplied per-user at runtime via the in-app key manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MP_API_KEY=


