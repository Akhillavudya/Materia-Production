# ── Materia backend environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Auth / security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet key used to encrypt user-supplied API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=materia.db

# ── LLM provider ─────────────────────────────────────────────────────────────
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# ── Optional hosted-model / materials-database keys ──────────────────────────
# These can also be supplied per-user at runtime via the in-app key manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MP_API_KEY=P9TDWiUZB0qYc5WIvLIK8kvFi5MTFLd1


